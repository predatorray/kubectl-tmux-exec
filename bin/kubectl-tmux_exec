set -euf -o pipefail

# Stack Overflow: https://stackoverflow.com/a/246128/1122665
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    PROG_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$PROG_DIR/$SOURCE"
done
PROG_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

readonly PROG_NAME='kubectl tmux-exec'

declare -ra KUBECTL_SHORT_OPTS=(
    's'
)

declare -ra KUBECTL_LONG_OPTS=(
    'container'
    'cluster'
    'password'
    'request-timeout'
    'server'
    'token'
    'user'
    'username'
    'kubeconfig'
)

declare -ra KUBECTL_NOARG_LONG_OPTS=(
    'insecure-skip-tls-verify'
)

# Options that do NOT take an argument
declare -ra SCRIPT_NOARG_SHORT_OPTS=(
    'A' 'h' 'V' 'i' 't' 'd' 'C'
)

# Options that DO require an argument
declare -ra SCRIPT_ARG_SHORT_OPTS=(
    'c' 'l' 'f' 'n'
)

declare -ra TMUX_LAYOUTS=(
    'even-horizontal'
    'even-vertical'
    'main-horizontal'
    'main-vertical'
    'tiled'
)

declare -ra SESSION_MODES=(
    'auto'
    'new-session'
    'current-session'
)

# Prints one line per object: API_VERSION, KIND, NAME, NAMESPACE, UID and the label selector of the object (if any),
# separated by tabs. Both the selector formats are supported: a plain map (e.g. services) and matchLabels /
# matchExpressions (e.g. deployments). Every requirement of the selector is followed by a comma.
readonly RESOURCE_TEMPLATE='{{range .items}}{{.apiVersion}}{{"\t"}}{{.kind}}{{"\t"}}{{.metadata.name}}{{"\t"}}'\
'{{.metadata.namespace}}{{"\t"}}{{.metadata.uid}}{{"\t"}}'\
'{{with .spec.selector}}{{if or .matchLabels .matchExpressions}}'\
'{{range $k, $v := .matchLabels}}{{$k}}={{$v}},{{end}}'\
'{{range .matchExpressions}}'\
'{{if eq .operator "In"}}{{.key}} in ({{range $i, $v := .values}}{{if $i}},{{end}}{{$v}}{{end}}),'\
'{{else if eq .operator "NotIn"}}{{.key}} notin ({{range $i, $v := .values}}{{if $i}},{{end}}{{$v}}{{end}}),'\
'{{else if eq .operator "Exists"}}{{.key}},'\
'{{else if eq .operator "DoesNotExist"}}!{{.key}},'\
'{{end}}{{end}}'\
'{{else}}{{range $k, $v := .}}{{$k}}={{$v}},{{end}}{{end}}{{end}}'\
'{{"\n"}}{{end}}'

# Prints one line per object: NAME, NAMESPACE, UID and the UID of its controller (if any), separated by spaces.
readonly CONTROLLED_BY_TEMPLATE='{{range .items}}{{.metadata.name}} {{.metadata.namespace}} {{.metadata.uid}}'\
'{{range .metadata.ownerReferences}}{{if .controller}} {{.uid}}{{end}}{{end}}{{"\n"}}{{end}}'

function usage() {
    cat << EOF
Execute a command in all containers that match the label selector, the pod list, or the resource using Tmux.

Examples:
  # Open bash terminals that attach to all the pods of the deployment 'nginx'
  ${PROG_NAME} deploy/nginx /bin/bash

  # Open a bash terminal that attaches to the pod 'nginx-0'
  ${PROG_NAME} nginx-0 /bin/bash

  # Keep tracking nginx access logs by running 'tail' command from all pods that match the selector 'app=nginx',
  # using the first container by default
  ${PROG_NAME} -l app=nginx -- tail -f /var/log/nginx/access.log

  # Open bash terminals that attach to 'nginx' containers of all nginx pods
  ${PROG_NAME} -l app=nginx -c nginx /bin/bash

  # Read pod names from a file instead of using a selector
  ${PROG_NAME} -f pods.txt /bin/bash
  ${PROG_NAME} -f - /bin/bash # read from stdin

  # Open bash terminals that attach to all nginx pods in both the namespace n1 and n2
  ${PROG_NAME} -l app=nginx -n ns1 -n n2 /bin/bash

  # Open bash terminals that attach to all nginx pods under both the context c1 and c2
  ${PROG_NAME} -l app=nginx --context c1 --context c2 /bin/bash

Options:
  -V, --version: Print the version information
  -c, --container='': Container name. If omitted, the first container in the pod will be chosen
  -n, --namespace='': The namespace scope for this CLI request (can be applied multiple times)
  --context='': The name of the kubeconfig context to use (can be applied multiple times)
  -A, --all-namespaces=false: If present, list and execute the requested object(s) across all namespaces.
                              Namespace in current context is ignored even if specified with --namespace.
  -i, --stdin=true: Pass stdin to the container (deprecated, since it's enabled by default)
  -t, --tty=true: Stdin is a TTY (deprecated, since it's enabled by default)
  -l, --selector: Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)
  -f, --file: Read pod names line-by-line from a file
  -d, --detach=false: Make the Tmux session detached
  -C, --enable-control-mode: Start tmux in control mode and echo is disabled.
  --session-mode=auto: Where tmux is opened:
                       new-session (always in a new session no matter whether there is an existing or not)
                       current-session (re-use the current session)
                       auto ('current-session' if there is an existing one, otherwise 'new-session')
  --remain-on-exit=false: Remain Tmux window on exit
  --select-layout=tiled: One of the five Tmux preset layouts: even-horizontal, even-vertical, main-horizontal,
                         main-vertical, or tiled.
  --dry-run=false: Only print the tmux commands that would be executed.
Usage:
  ${PROG_NAME} { -l SELECTOR | -f FILE | NAME } [-c CONTAINER] [flags] -- COMMAND [args...]

Arguments:
  NAME: A pod name, or TYPE/NAME of a resource that is supported by 'kubectl exec': a pod, service, deployment,
        replicaset, replicationcontroller, statefulset, daemonset or job (e.g. deploy/nginx, sts/web, svc/nginx).
        Unlike 'kubectl exec', which picks only one pod of the resource, all of its pods are chosen. For a workload,
        only the pods it controls are chosen, not the others that happen to match its selector.

Use "kubectl options" for a list of global command-line options (applies to all commands).
EOF
}

function print_version() {
    local version_file="${PROG_DIR}/../VERSION"
    if [[ -f "${version_file}" ]]; then
        cat "${version_file}"
    else
        echo "unknown"
    fi
}

function check_required_executables() {
    for exe in "$@"; do
        if ! which "${exe}" 2>&1 >/dev/null; then
            echo >&2 "command not found: ${exe}"
            exit 127
        fi
    done
}

function warn() {
    echo >&2 'warn:' "$@"
}

function error_and_exit() {
    echo >&2 'error:' "$@"
    echo >&2 "Run '${PROG_NAME} --help' for more information on the command."
    exit 1
}

function error_option_requires_arg() {
    error_and_exit "option ${1} requires an argument"
}

function array_contains() {
    local occur="$1"
    local arr=("${@:2}")
    for e in "${arr[@]}"; do
        if [[ "${e}" == "${occur}" ]]; then
            return 0
        fi
    done
    return 1
}

# Prints "NAME NAMESPACE UID" of the objects of RESOURCE_TYPE in NAMESPACE that match the SELECTOR and are controlled by
# (i.e. the controller owner reference is) one of the OWNER_UIDS.
function get_controlled_by() {
    local resource_type="$1"
    local ctx_opt="$2"
    local namespace="$3"
    local selector="$4"
    local owner_uids=("${@:5}")

    local selector_opts=()
    if [[ -n "${selector}" ]]; then
        selector_opts=(-l "${selector}")
    fi

    local name ns uid controller_uid
    while read -r name ns uid controller_uid; do
        if [[ -n "${name}" ]] && [[ -n "${controller_uid}" ]] && array_contains "${controller_uid}" "${owner_uids[@]}"; then
            echo "${name} ${ns} ${uid}"
        fi
    done < <(
        kubectl ${kubectl_opts[@]:-} get "${resource_type}" --context "${ctx_opt}" -n "${namespace}" ${selector_opts[@]:+"${selector_opts[@]}"} -o "go-template=${CONTROLLED_BY_TEMPLATE}" || true
    )
}

# Prints "POD_NAME NAMESPACE" for every pod that the resource TYPE/NAME refers to, the same way as 'kubectl exec'
# resolves it (see SelectorsForObject in k8s.io/kubectl/pkg/polymorphichelpers), except that all the pods are printed
# instead of only the first one:
#   - a pod is printed as is;
#   - for a service, all the pods that match its selector;
#   - for a replicaset, replicationcontroller, statefulset, daemonset, job or deployment, all the pods that match its
#     selector, and, unlike 'kubectl exec', are also controlled by it (via a replicaset for a deployment), so that the
#     pods that merely share the labels are not included.
function get_pods_by_resource() {
    local resource_type="$1"
    local resource_name="$2"
    local ctx_opt="$3"
    local ns_opts=("${@:4}")

    local resources rc=0
    resources="$(kubectl ${kubectl_opts[@]:-} get "${resource_type}" --context "${ctx_opt}" "${ns_opts[@]}" --field-selector "metadata.name=${resource_name}" -o "go-template=${RESOURCE_TEMPLATE}")" || rc=$?
    if [[ "${rc}" -ne 0 ]]; then
        # kubectl has already printed the error, e.g. the server doesn't have a resource type "foo"
        return 0
    fi
    if [[ -z "${resources}" ]]; then
        local where=''
        if [[ "${ns_opts[0]}" == '-A' ]]; then
            where=' in any namespace'
        elif [[ -n "${ns_opts[1]:-}" ]]; then
            where=" in the namespace ${ns_opts[1]}"
        fi
        if [[ -n "${ctx_opt}" ]]; then
            where="${where} of the context ${ctx_opt}"
        fi
        warn "${resource_type}/${resource_name} not found${where}"
        return 0
    fi

    local api_version kind name namespace uid selector
    while IFS=$'\t' read -r api_version kind name namespace uid selector; do
        if [[ -z "${name}" ]]; then
            continue
        fi
        selector="${selector%,}"

        local api_group=''
        if [[ "${api_version}" == */* ]]; then
            api_group="${api_version%/*}"
        fi

        local owner_uids=()
        case "${api_group}/${kind}" in
            /Pod)
                echo "${name} ${namespace}"
                continue
                ;;
            /Service)
                if [[ -z "${selector}" ]]; then
                    warn "invalid service '${name}' in the namespace ${namespace}: Service is defined without a selector"
                    continue
                fi
                kubectl ${kubectl_opts[@]:-} get pods --context "${ctx_opt}" -n "${namespace}" -l "${selector}" -o custom-columns=':metadata.name,:metadata.namespace' --no-headers || true
                continue
                ;;
            /ReplicationController|apps/ReplicaSet|extensions/ReplicaSet|apps/StatefulSet|apps/DaemonSet|extensions/DaemonSet|batch/Job)
                owner_uids=("${uid}")
                ;;
            apps/Deployment|extensions/Deployment)
                local rs_name rs_ns rs_uid
                while read -r rs_name rs_ns rs_uid; do
                    owner_uids+=("${rs_uid}")
                done < <(get_controlled_by replicasets "${ctx_opt}" "${namespace}" "${selector}" "${uid}")
                ;;
            *)
                warn "cannot exec into ${resource_type}/${name} in the namespace ${namespace}: selector for ${kind} (${api_version}) not implemented"
                continue
                ;;
        esac

        if [[ "${#owner_uids[@]}" -gt 0 ]]; then
            local pod_name pod_ns pod_uid
            while read -r pod_name pod_ns pod_uid; do
                echo "${pod_name} ${pod_ns}"
            done < <(get_controlled_by pods "${ctx_opt}" "${namespace}" "${selector}" "${owner_uids[@]}")
        fi
    done <<< "${resources}"
}

function main() {
    local selector
    local resource
    local container_name
    local namespaces=()
    local contexts=()
    local kubectl_opts=()
    local remain_on_exit=0
    local tmux_layout='tiled'
    local pod_list_file
    local tmux_detach=0
    local session_mode='auto'
    local enable_control_mode=0
    local all_namespaces=0
    local dry_run=0

    while [[ $# -gt 0 ]]; do
        local opt="$1"
        case "${opt}" in
            -h|--help)
                usage
                exit 0
                ;;
            -V|--version)
                print_version
                exit 0
                ;;
            -c|--container)
                shift
                if [[ $# -eq 0 ]]; then
                    error_option_requires_arg "${opt}"
                fi
                container_name="$1"
                ;;
            -c*)
                container_name="${opt:2}"
                ;;
            --container=*)
                container_name="${opt#*=}"
                ;;
            -n|--namespace)
                shift
                if [[ $# -eq 0 ]]; then
                    error_option_requires_arg "${opt}"
                fi
                if [[ "${#namespaces[@]}" -eq 0 ]] || ! array_contains "$1" "${namespaces[@]}"; then
                    namespaces+=("$1")
                fi
                ;;
            -n*)
                local val="${opt:2}"
                if [[ "${#namespaces[@]}" -eq 0 ]] || ! array_contains "${val}" "${namespaces[@]}"; then
                    namespaces+=("${val}")
                fi
                ;;
            --namespace=*)
                local val="${opt#*=}"
                if [[ "${#namespaces[@]}" -eq 0 ]] || ! array_contains "${val}" "${namespaces[@]}"; then
                    namespaces+=("${val}")
                fi
                ;;
            -A|--all-namespaces)
                all_namespaces=1
                ;;
            --context)
                shift
                if [[ $# -eq 0 ]]; then
                    error_option_requires_arg "${opt}"
                fi
                if [[ "${#contexts[@]}" -eq 0 ]] || ! array_contains "$1" "${contexts[@]}"; then
                    contexts+=("$1")
                fi
                ;;
            --context=*)
                local val="${opt#*=}"
                if [[ "${#contexts[@]}" -eq 0 ]] || ! array_contains "${val}" "${contexts[@]}"; then
                    contexts+=("${val}")
                fi
                ;;
            -i|--stdin)
                warn "The option -i / --stdin is deprecated."
                ;;
            -t|--tty)
                warn "The option -t / --tty is deprecated."
                ;;
            -l|--selector)
                shift
                if [[ $# -eq 0 ]]; then
                    error_option_requires_arg "${opt}"
                fi
                selector="$1"
                ;;
            -l*)
                selector="${opt:2}"
                ;;
            --selector=*)
                selector="${opt#*=}"
                ;;
            -d|--detach)
                tmux_detach=1
                ;;
            --remain-on-exit)
                remain_on_exit=1
                ;;
            --select-layout)
                shift
                if [[ $# -eq 0 ]]; then
                    error_option_requires_arg "${opt}"
                fi
                tmux_layout="$1"
                ;;
            --select-layout=*)
                tmux_layout="${opt#*=}"
                ;;
            --session-mode)
                shift
                if [[ $# -eq 0 ]]; then
                    error_option_requires_arg "${opt}"
                fi
                session_mode="$1"
                ;;
            --session-mode=*)
                session_mode="${opt#*=}"
                ;;
            -f|--file)
                shift
                if [[ $# -eq 0 ]]; then
                    error_option_requires_arg "${opt}"
                fi
                pod_list_file="$1"
                ;;
            -f*)
                pod_list_file="${opt:2}"
                ;;
            --file=*)
                pod_list_file="${opt#*=}"
                ;;
            -C|--enable-control-mode)
                enable_control_mode=1
                ;;
            --dry-run)
                dry_run=1
                ;;
            --)
                shift
                break
                ;;
            -??*)
                local first="${opt:0:2}"
                local first_char="${first:1}"
                local rest="${opt:2}"

                if array_contains "${first_char}" "${SCRIPT_NOARG_SHORT_OPTS[@]}" || \
                   array_contains "${first_char}" "${SCRIPT_ARG_SHORT_OPTS[@]}" || \
                   array_contains "${first_char}" "${KUBECTL_SHORT_OPTS[@]}"; then
                    shift
                    set -- "${first}" "-${rest}" "$@"
                    continue
                fi
                # Fall through to unknown option handling
                ;&
            -*)
                if [[ "${opt}" =~ ^--(.+)=(.+)$ ]]; then
                    local name="${BASH_REMATCH[1]}"
                    local val="${BASH_REMATCH[2]}"
                    if array_contains "${name}" "${KUBECTL_LONG_OPTS[@]}"; then
                        kubectl_opts+=("--${name}" "${val}")
                    else
                        error_and_exit "unknown option: ${opt}"
                    fi
                elif [[ "${opt}" =~ ^--(.+)$ ]]; then
                    local name="${BASH_REMATCH[1]}"
                    if array_contains "${name}" "${KUBECTL_NOARG_LONG_OPTS[@]}"; then
                        kubectl_opts+=("${opt}")
                    elif array_contains "${name}" "${KUBECTL_LONG_OPTS[@]}"; then
                        shift
                        if [[ $# -eq 0 ]]; then
                            error_option_requires_arg "${opt}"
                        fi
                        kubectl_opts+=("${opt}" "$1")
                    else
                        error_and_exit "unknown option: ${opt}"
                    fi
                elif [[ "${#opt}" -eq 2 ]]; then
                    if array_contains "${opt:1}" "${KUBECTL_SHORT_OPTS[@]}"; then
                        shift
                        if [[ $# -eq 0 ]]; then
                            error_option_requires_arg "${opt}"
                        fi
                        kubectl_opts+=("${opt}" "$1")
                    else
                        error_and_exit "unknown option: ${opt}"
                    fi
                else
                    error_and_exit "unknown option: ${opt}"
                fi
                ;;
            *)
                # The first argument that is not an option is the NAME, unless the pods are already chosen by -l or -f,
                # where it is the beginning of the command instead.
                if [[ -z "${selector:-}" ]] && [[ -z "${pod_list_file:-}" ]] && [[ -z "${resource:-}" ]]; then
                    resource="${opt}"
                else
                    break
                fi
                ;;
        esac
        shift
    done

    check_required_executables 'kubectl' 'tmux'

    if [[ $# -eq 0 ]]; then
        error_and_exit 'you must specify at least one command for the container'
    fi

    local pod_source_count=0
    [[ -n "${selector:-}" ]] && (( ++pod_source_count ))
    [[ -n "${pod_list_file:-}" ]] && (( ++pod_source_count ))
    [[ -n "${resource:-}" ]] && (( ++pod_source_count ))
    if [[ "${pod_source_count}" -ne 1 ]]; then
       error_and_exit 'you must specify exactly one of option -l, option -f, or a NAME'
    fi

    local resource_type resource_name
    if [[ -n "${resource:-}" ]]; then
        if [[ "${resource}" == */* ]]; then
            resource_type="${resource%%/*}"
            resource_name="${resource#*/}"
        else
            resource_type='pod'
            resource_name="${resource}"
        fi
        if [[ -z "${resource_type}" ]] || [[ -z "${resource_name}" ]] || [[ "${resource_name}" == */* ]]; then
            error_and_exit "invalid resource name: ${resource}"
        fi
    fi

    if [[ -z "${tmux_layout}" ]] || ! array_contains "${tmux_layout}" "${TMUX_LAYOUTS[@]}"; then
        error_and_exit "Unknown layout: ${tmux_layout}"
    fi

    if [[ -z "${session_mode}" ]] || ! array_contains "${session_mode}" "${SESSION_MODES[@]}"; then
        error_and_exit "Unknown session mode: ${session_mode}"
    fi

    if [[ "${#namespaces[@]}" -eq 0 ]]; then
        namespaces=('')
    fi

    if [[ "${#contexts[@]}" -eq 0 ]]; then
        contexts=('')
    fi

    local commands=("$@")

    local kubectl_exec_opts='-i -t'
    if [[ ! -z "${container_name:-}" ]]; then
        kubectl_exec_opts="${kubectl_exec_opts} -c ${container_name}"
    fi

    local exec_cmd_str=''
    for arg in "${commands[@]}"; do
        if [[ -z "${exec_cmd_str}" ]]; then
            exec_cmd_str="$(printf '%q' "${arg}")"
        else
            exec_cmd_str="${exec_cmd_str} $(printf '%q' "${arg}")"
        fi
    done

    if [[ ! -z "${pod_list_file:-}" ]] && [[ "${pod_list_file}" != '-' ]] && [[ ! -f "${pod_list_file}" ]]; then
        error_and_exit "No such file or directory: ${pod_list_file}"
    fi

    local deduplicated_pod_list=()
    if [[ -n "${pod_list_file:-}" ]]; then
        if [[ "${pod_list_file}" = '-' ]] && [[ -t 0 ]] && [[ -t 2 ]]; then
            echo >&2 'Reading pod names from stdin... (Press Ctrl-D at the beginning of the last line to stop reading)'
        fi
        while IFS='' read -r pod_name; do
            if [[ -z "${pod_name}" ]]; then
                continue
            fi
            if [[ "${#deduplicated_pod_list[@]}" -eq 0 ]] || ! array_contains "${pod_name}" "${deduplicated_pod_list[@]}"; then
                deduplicated_pod_list+=("${pod_name}")
            fi
        done < <(cat "${pod_list_file}")

        if [[ "${#deduplicated_pod_list[@]}" -eq 0 ]]; then
            echo >&2 'No pods found.'
            exit 0
        fi
    fi

    local pods=()
    for ctx_opt in "${contexts[@]}"; do
        if [[ "${all_namespaces}" -eq 0 ]]; then
            for ns_opt in "${namespaces[@]}"; do
                while read -r pod_name namespace; do
                    if [[ -z "${pod_name}" ]]; then
                        continue
                    fi
                    local pod_info="${pod_name}/${namespace}/${ctx_opt}"
                    if [[ "${#pods[@]}" -gt 0 ]] && array_contains "${pod_info}" "${pods[@]}"; then
                        continue
                    fi
                    pods+=("${pod_info}")
                done < <(
                    if [[ -n "${resource:-}" ]]; then
                        get_pods_by_resource "${resource_type}" "${resource_name}" "${ctx_opt}" -n "${ns_opt}"
                    elif [[ -z "${selector:-}" ]]; then
                        for pod_name in "${deduplicated_pod_list[@]}"; do
                            kubectl ${kubectl_opts[@]:-} get pod --context "${ctx_opt}" -n "${ns_opt}" "${pod_name}" -o custom-columns=':metadata.name,:metadata.namespace' --no-headers 2>/dev/null || true
                        done
                    else
                        kubectl ${kubectl_opts[@]:-} get pods --context "${ctx_opt}" -n "${ns_opt}" -l "${selector}" -o custom-columns=':metadata.name,:metadata.namespace' --no-headers 2>/dev/null || true
                    fi
                )
            done
        else
            # all namespaces
            while read -r pod_name namespace; do
                if [[ -z "${pod_name}" ]]; then
                    continue
                fi
                local pod_info="${pod_name}/${namespace}/${ctx_opt}"
                if [[ "${#pods[@]}" -gt 0 ]] && array_contains "${pod_info}" "${pods[@]}"; then
                    continue
                fi
                pods+=("${pod_info}")
            done < <(
                if [[ -n "${resource:-}" ]]; then
                    get_pods_by_resource "${resource_type}" "${resource_name}" "${ctx_opt}" -A
                elif [[ -z "${selector:-}" ]]; then
                    for pod_name in "${deduplicated_pod_list[@]}"; do
                        kubectl ${kubectl_opts[@]:-} get pod --context "${ctx_opt}" -A "${pod_name}" -o custom-columns=':metadata.name,:metadata.namespace' --no-headers 2>/dev/null || true
                    done
                else
                    kubectl ${kubectl_opts[@]:-} get pods --context "${ctx_opt}" -A -l "${selector}" -o custom-columns=':metadata.name,:metadata.namespace' --no-headers 2>/dev/null || true
                fi
            )
        fi
    done

    if [[ "${#pods[@]}" -eq 0 ]]; then
        echo >&2 'No pods found.'
        exit 0
    fi

    local tmux_commands=()
    if [[ "${enable_control_mode}" -eq 1 ]]; then
        tmux_commands+=('-CC')
    fi
    local cmd_initial_len="${#tmux_commands[@]}"
    for pod in "${pods[@]}"; do
        IFS='/' read -r pod_name namespace context <<< "${pod}"
        local cmd="kubectl ${kubectl_opts[@]:-}"

        if [[ -n "${namespace}" ]]; then
            cmd="${cmd} -n ${namespace}"
        fi
        if [[ -n "${context}" ]]; then
            cmd="${cmd} --context ${context}"
        fi

        cmd="${cmd} exec ${kubectl_exec_opts} ${pod_name} -- ${exec_cmd_str}"

        if [[ "${#tmux_commands[@]}" -eq "${cmd_initial_len}" ]]; then
            local open_command
            if [[ "${session_mode}" == 'new-session' ]]; then
                open_command='new-session'
            elif [[ "${session_mode}" == 'current-session' ]]; then
                open_command='new-window'
            elif [[ -z "${TMUX:-}" ]]; then
                open_command='new-session'
            else
                open_command='new-window'
            fi

            if [[ "${tmux_detach}" -eq 0 ]]; then
                tmux_commands+=("${open_command}" "${cmd}" ';')
            else
                tmux_commands+=("${open_command}" '-d' "${cmd}" ';')
            fi
        else
            tmux_commands+=('split-window' "${cmd}" ';')
        fi
        tmux_commands+=('select-layout' "${tmux_layout}" ';')
    done

    if [[ "${remain_on_exit}" -eq 1 ]]; then
        tmux_commands+=('set-option' 'remain-on-exit' 'on' ';')
    fi
    if [[ "${enable_control_mode}" -eq 0 ]]; then
        tmux_commands+=('setw' 'synchronize-panes' 'on' ';')
    fi

    if [[ "${dry_run}" -eq 0 ]]; then
        exec tmux "${tmux_commands[@]}"
    else
        echo tmux "${tmux_commands[@]}"
    fi
}

main "$@"

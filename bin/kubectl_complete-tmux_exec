declare -ra KUBECTL_ARG_SHORT_OPTS=(
    '-s'
)

declare -ra KUBECTL_ARG_LONG_OPTS=(
    '--cluster'
    '--password'
    '--request-timeout'
    '--server'
    '--token'
    '--user'
    '--username'
    '--kubeconfig'
)

declare -ra KUBECTL_NOARG_LONG_OPTS=(
    '--insecure-skip-tls-verify'
)

declare -ra ALL_NOARG_SHORT_OPTS=(
    '-A'
    '-h'
    '-V'
    '-i'
    '-t'
    '-d'
    '-C'
)

declare -ra ALL_ARG_SHORT_OPTS=(
    '-c'
    '-l'
    '-f'
    '-n'
    "${KUBECTL_ARG_SHORT_OPTS[@]}"
)

declare -ra ALL_SHORT_OPTS=(
    "${ALL_NOARG_SHORT_OPTS[@]}"
    "${ALL_ARG_SHORT_OPTS[@]}"
)

declare -ra ALL_NOARG_LONG_OPTS=(
    '--help'
    '--version'
    '--dry-run'
    '--stdin'
    '--tty'
    '--detach'
    '--remain-on-exit'
    '--all-namespaces'
    '--enable-control-mode'
    "${KUBECTL_NOARG_LONG_OPTS[@]}"
)

declare -ra ALL_ARG_LONG_OPTS=(
    '--container'
    '--selector'
    '--select-layout'
    '--session-mode'
    '--file'
    '--namespace'
    '--context'
    "${KUBECTL_ARG_LONG_OPTS[@]}"
)

declare -ra ALL_LONG_OPTS=(
    "${ALL_NOARG_LONG_OPTS[@]}"
    "${ALL_ARG_LONG_OPTS[@]}"
)

declare -ra ALL_ARG_OPTS=(
    "${ALL_ARG_SHORT_OPTS[@]}"
    "${ALL_ARG_LONG_OPTS[@]}"
)

declare -ra FILE_OPTS=(
    '-f'
    '--file'
    '--kubeconfig'
)

declare -ra ALL_OPTS=(
    "${ALL_SHORT_OPTS[@]}"
    "${ALL_LONG_OPTS[@]}"
)

declare -ra TMUX_LAYOUTS=(
    'even-horizontal'
    'even-vertical'
    'main-horizontal'
    'main-vertical'
    'tiled'
)

declare -ra SESSION_MODES=(
    'auto'
    'new-session'
    'current-session'
)

# Cobra's Shell Comp Directive Constants
# also see: https://github.com/spf13/cobra/blob/main/completions.go
readonly NO_FILE_COMP_DIR=':4'
readonly NO_FILE_NO_SPACE_COMP_DIR=':6'
readonly FILTER_FILE_COMP_DIR=':8'

readonly KUBECTL_REQUEST_TIMEOUT='5s'

# The resource types that contain pods, which are completed as TYPE/ for the NAME argument, the same as 'kubectl exec'
# (see doPodResourceCompletion in k8s.io/kubectl/pkg/util/completion)
declare -ra RESOURCES_WITH_PODS=(
    'daemonsets'
    'deployments'
    'pods'
    'jobs'
    'replicasets'
    'replicationcontrollers'
    'services'
    'statefulsets'
)

function array_contains() {
    local occur="$1"
    local arr=("${@:2}")
    for e in "${arr[@]}"; do
        if [[ "${e}" == "${occur}" ]]; then
            return 0
        fi
    done
    return 1
}

function __kubectl() {
    local output
    output="$(mktemp "${kubectl_output_dir}/XXXXXX")" || return
    (kubectl "${kubectl_opts[@]}" "$@" > "${output}" 2>/dev/null || rm -f "${output}") &
}

function __collect() {
    local kubectl_output_dir
    kubectl_output_dir="$(mktemp -d)" || return
    "$@"
    wait
    cat "${kubectl_output_dir}"/* 2>/dev/null
    rm -rf "${kubectl_output_dir}"
}

function __kubectl_each_context() {
    local ctx
    for ctx in "${contexts[@]:-}"; do
        __kubectl ${ctx:+--context "${ctx}"} "$@"
    done
}

function __get_resources() {
    local resource_type="$1"
    local output="$2"
    local extra_args=("${@:3}")
    if [[ "${all_namespaces}" -eq 1 ]]; then
        __kubectl_each_context get "${resource_type}" --all-namespaces "${extra_args[@]}" -o "${output}"
        return
    fi
    local ns
    for ns in "${namespaces[@]:-}"; do
        __kubectl_each_context get "${resource_type}" ${ns:+--namespace "${ns}"} "${extra_args[@]}" -o "${output}"
    done
}

function __get_pods() {
    __get_resources pods "$1" ${selector:+--selector "${selector}"}
}

# Completes the NAME argument, the same as 'kubectl exec': pod names and the TYPE/ of the resources that contain pods,
# or TYPE/NAME if the word being completed contains a slash. The options are also completed if the word is empty.
function __complete_name() {
    local value="$1"
    local resource_type='pods'
    local prefix=''
    if [[ "${value}" == */* ]]; then
        resource_type="${value%%/*}"
        prefix="${resource_type}/"
    fi

    local names=()
    local name
    while IFS='' read -r name; do
        if [[ "${prefix}${name}" == "${value}"* ]]; then
            names+=("${prefix}${name}")
        fi
    done < <(__collect __get_resources "${resource_type}" 'jsonpath={range .items[*]}{.metadata.name}{"\n"}{end}' | sort -u)
    if [[ "${#names[@]}" -gt 0 ]]; then
        printf -- '%s\n' "${names[@]}"
    fi

    if [[ -n "${prefix}" ]]; then
        echo "${NO_FILE_COMP_DIR}"
        return
    fi
    local type
    for type in "${RESOURCES_WITH_PODS[@]}"; do
        if [[ "${type}" == "${value}"* ]]; then
            echo "${type}/"
        fi
    done
    if [[ -z "${value}" ]]; then
        printf -- '%s\n' "${ALL_OPTS[@]}"
        echo "${NO_FILE_COMP_DIR}"
    elif [[ "${#names[@]}" -eq 0 ]]; then
        # only TYPE/ is completed, so do not add a space after the slash
        echo "${NO_FILE_NO_SPACE_COMP_DIR}"
    else
        echo "${NO_FILE_COMP_DIR}"
    fi
}

function __complete_labels() {
    local value="$1"
    local prefix=''
    local used_keys=()
    if [[ "${value}" == *,* ]]; then
        prefix="${value%,*},"
        local terms term
        IFS=',' read -ra terms <<< "${value%,*}"
        for term in "${terms[@]}"; do
            term="${term#!}"
            used_keys+=("${term%%[=!]*}")
        done
    fi
    __collect __get_pods 'go-template={{range .items}}{{range $k, $v := .metadata.labels}}{{$k}}={{$v}}{{"\n"}}{{end}}{{end}}' \
        | sort -u \
        | while IFS='' read -r label; do
            if ! array_contains "${label%%=*}" "${used_keys[@]}"; then
                printf -- '%s%s\n' "${prefix}" "${label}"
            fi
        done
}

function __complete_value() {
    local opt="$1"
    local value="$2"
    case "${opt}" in
        '--session-mode')
            printf -- '%s\n' "${SESSION_MODES[@]}"
            ;;
        '--select-layout')
            printf -- '%s\n' "${TMUX_LAYOUTS[@]}"
            ;;
        '-n' | '--namespace')
            __collect __kubectl_each_context get namespaces -o 'jsonpath={range .items[*]}{.metadata.name}{"\n"}{end}' | sort -u
            ;;
        '--context')
            __collect __kubectl config get-contexts -o name
            ;;
        '--cluster')
            __collect __kubectl config view -o 'jsonpath={range .clusters[*]}{.name}{"\n"}{end}'
            ;;
        '--user')
            __collect __kubectl config view -o 'jsonpath={range .users[*]}{.name}{"\n"}{end}'
            ;;
        '-c' | '--container')
            __collect __get_pods 'jsonpath={range .items[*].spec.containers[*]}{.name}{"\n"}{end}' | sort -u
            ;;
        '-l' | '--selector')
            __complete_labels "${value}"
            ;;
        *)
            if array_contains "${opt}" "${FILE_OPTS[@]}"; then
                echo "${FILTER_FILE_COMP_DIR}"
                return
            fi
            ;;
    esac
    echo "${NO_FILE_COMP_DIR}"
}

function __record_option() {
    local opt="$1"
    local value="$2"
    case "${opt}" in
        '-n' | '--namespace')
            if ! array_contains "${value}" "${namespaces[@]}"; then
                namespaces+=("${value}")
            fi
            ;;
        '--context')
            if ! array_contains "${value}" "${contexts[@]}"; then
                contexts+=("${value}")
            fi
            ;;
        '-l' | '--selector')
            selector="${value}"
            ;;
        '-f' | '--file')
            pod_list_file="${value}"
            ;;
        *)
            if array_contains "${opt}" "${KUBECTL_ARG_SHORT_OPTS[@]}" "${KUBECTL_ARG_LONG_OPTS[@]}"; then
                kubectl_opts+=("${opt}" "${value}")
            fi
            ;;
    esac
}

function __complete() {
    if [[ "$#" -eq 0 ]]; then
        exit 1
    fi

    local kubectl_opts=('--request-timeout' "${KUBECTL_REQUEST_TIMEOUT}")
    local namespaces=()
    local contexts=()
    local selector=''
    local pod_list_file=''
    local resource=''
    local all_namespaces=0

    local state='OPTS'
    local value_opt
    for arg in "${@:1:$#-1}"; do
        case "${state}" in
            'OPTS')
                case "${arg}" in
                    '--')
                        state='CMD'
                        ;;
                    '-A' | '--all-namespaces')
                        all_namespaces=1
                        ;;
                    --*=*)
                        __record_option "${arg%%=*}" "${arg#*=}"
                        ;;
                    -*)
                        if array_contains "${arg}" "${ALL_ARG_OPTS[@]}"; then
                            state='VALUE'
                            value_opt="${arg}"
                        elif array_contains "${arg}" "${KUBECTL_NOARG_LONG_OPTS[@]}"; then
                            kubectl_opts+=("${arg}")
                        elif array_contains "${arg:0:2}" "${ALL_ARG_SHORT_OPTS[@]}"; then
                            __record_option "${arg:0:2}" "${arg:2}"
                        fi
                        ;;
                    *)
                        # the NAME argument, unless the pods are already chosen by -l or -f
                        if [[ -z "${selector}" ]] && [[ -z "${pod_list_file}" ]] && [[ -z "${resource}" ]]; then
                            resource="${arg}"
                        else
                            state='CMD'
                        fi
                        ;;
                esac
                ;;
            'VALUE')
                __record_option "${value_opt}" "${arg}"
                state='OPTS'
                ;;
        esac
    done

    local cur="${!#}"
    case "${state}" in
        'CMD')
            echo "${NO_FILE_COMP_DIR}"
            ;;
        'VALUE')
            __complete_value "${value_opt}" "${cur}"
            ;;
        'OPTS')
            case "${cur}" in
                --*=*)
                    __complete_value "${cur%%=*}" "${cur#*=}"
                    ;;
                --*)
                    printf -- '%s\n' "${ALL_LONG_OPTS[@]}"
                    echo "${NO_FILE_COMP_DIR}"
                    ;;
                -*)
                    printf -- '%s\n' "${ALL_OPTS[@]}"
                    echo "${NO_FILE_COMP_DIR}"
                    ;;
                *)
                    if [[ -z "${selector}" ]] && [[ -z "${pod_list_file}" ]] && [[ -z "${resource}" ]]; then
                        __complete_name "${cur}"
                    elif [[ -z "${cur}" ]]; then
                        printf -- '%s\n' "${ALL_OPTS[@]}"
                        echo "${NO_FILE_COMP_DIR}"
                    else
                        echo "${NO_FILE_COMP_DIR}"
                    fi
                    ;;
            esac
            ;;
    esac
}

__complete "$@"
